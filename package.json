{
  "name": "mfec-pika-arena",
  "version": "0.1.0",
  "private": true,
  "description": "MFEC Pika Arena: live quiz and icebreaker game for MFEC teams, built from the Pika wiki",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm run dev -w @pika-arena/server\" \"npm run dev -w @pika-arena/web\"",
    "build": "npm run build -w @pika-arena/web",
    "start": "concurrently -k -n server,web -c cyan,magenta \"npm run start -w @pika-arena/server\" \"npm run start -w @pika-arena/web\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "e2e": "node e2e/sweep.mjs",
    "e2e:slider": "node e2e/slider-fit.mjs",
    "e2e:reveal": "node e2e/reveal-fit.mjs",
    "e2e:samples": "node e2e/samples-signed-out.mjs",
    "e2e:bank": "node e2e/bank.mjs",
    "e2e:exam": "node e2e/exam.mjs",
    "e2e:ask-ai": "node e2e/ask-ai.mjs",
    "e2e:sheet-import": "node e2e/sheet-import.mjs",
    "e2e:ai-quiz": "node e2e/ai-quiz.mjs",
    "e2e:pika": "node e2e/pika-exam.mjs",
    "e2e:create": "node e2e/create-nav.mjs",
    "e2e:sso": "node e2e/sso.mjs",
    "bots": "npm run bots -w @pika-arena/server --",
    "crowd": "npm run crowd -w @pika-arena/server --",
    "playthrough": "npm run playthrough -w @pika-arena/server --",
    "users": "npm run users -w @pika-arena/web --"
  },
  "engines": {
    "node": ">=20.9"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
